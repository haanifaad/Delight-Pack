# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Your Google Cloud Console OAuth Client ID
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Your Google Cloud Console OAuth Client Secret
GOOGLE_CLIENT_SECRET=

# Google Sheets Service Account sync (3-way sync)
# Download JSON key from GCP → save as google-credentials.json in this folder
GOOGLE_SERVICE_ACCOUNT_FILE=./google-credentials.json
# Spreadsheet ID from: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=
# Tab and column range for voucher row appends
GOOGLE_SHEET_RANGE=Sheet1!A:F

# Tally local bridge secret (must match scripts/tally-bridge/index.js)
LOCAL_BRIDGE_SECRET=LOCAL_BRIDGE_SECRET_123

# PostgreSQL connection (required for Tally → Web sync)
DATABASE_URL=postgresql://user:password@localhost:5432/mydatabase
