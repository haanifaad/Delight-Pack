# Firebase Extension: Trigger Email from Firestore
# https://extensions.dev/extensions/firebase/firestore-send-email
#
# Install via: firebase ext:install firebase/firestore-send-email
#
# Then write to the `mail` collection from a Cloud Function instead of Nodemailer:
#
#   await db.collection("mail").add({
#     to: contact.email,
#     message: {
#       subject: "Custom Packaging Request Confirmed",
#       html: "<p>...</p>",
#     },
#   });

SMTP_CONNECTION_URI=smtps://user:pass@smtp.example.com:465
DEFAULT_FROM=Delight Pack <noreply@delightpack.ae>
MAIL_COLLECTION=mail
