{
  "name": "dp-firebase-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('assets','lib/assets',{recursive:true})\"",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,storage",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "nodemailer": "^7.0.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.8.3"
  }
}
