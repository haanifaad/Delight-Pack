rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Custom packaging orders are written only by Cloud Functions (Admin SDK).
    match /custom_orders/{orderId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /quotations/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.customerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      allow update: if request.auth != null && request.auth.uid == resource.data.customerId && request.auth.uid == request.resource.data.customerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.customerId;
    }

    match /support_chats/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.customerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      allow update: if request.auth != null && request.auth.uid == resource.data.customerId && request.auth.uid == request.resource.data.customerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.customerId;
    }

    match /orders/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.customerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      allow update: if request.auth != null && request.auth.uid == resource.data.customerId && request.auth.uid == request.resource.data.customerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.customerId;
    }

    match /inventory/{docId} {
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    match /finance/{docId} {
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // Existing app collections (adjust auth when you add sign-in).
    match /transactions/{docId} {
      allow read, write: if true;
    }

    match /shift_logs/{document} {
      allow read, write: if isL3Staff();
    }
    
    // --- Phase 4 & 5 Collections ---
    match /maintenance_orders/{document} {
      allow read, write: if isL3Staff();
    }
    match /rmas/{document} {
      allow read, write: if isL3Staff();
    }
    match /inventory_variances/{document} {
      allow read, write: if isL3Staff();
    }
    match /quarantine_logs/{document} {
      allow read, write: if isL3Staff();
    }
    match /ink_mixing_logs/{document} {
      allow read, write: if isL3Staff();
    }
    
    // --- Phase 6 & 7 Collections ---
    match /gate_passes/{document} {
      allow read, write: if isL3Staff();
    }
    match /incident_reports/{document} {
      allow read, write: if isL3Staff();
    }
    match /shift_swaps/{document} {
      allow read, write: if isL3Staff();
    }
    
    // --- Phase 9 & 10 Collections ---
    match /quality_audits/{document} {
      allow read, write: if isL3Staff();
    }
    match /eco_metrics/{document} {
      allow read, write: if isL3Staff();
    }
    
    // Fallback for everything else
    match /{document=**} {
      allow read, write: if false;
    }

    match /spreadsheetData/{docId} {
      allow read, write: if true;
    }

    match /products/{docId} {
      allow read, write: if true;
    }

    // Staff (L3) Collections
    match /raw_materials/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'staff' || request.auth.token.isAdmin == true);
    }
    match /material_logs/{docId} {
      allow read, write: if request.auth != null && (request.auth.token.role == 'staff' || request.auth.token.isAdmin == true);
    }
    match /production_orders/{docId} {
      allow read, write: if request.auth != null && (request.auth.token.role == 'staff' || request.auth.token.isAdmin == true);
    }
    match /machines/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'staff' || request.auth.token.isAdmin == true);
    }
    match /shift_logs/{docId} {
      allow read, write: if request.auth != null && (request.auth.token.role == 'staff' || request.auth.token.isAdmin == true);
    }
    match /dispatch_drivers/{docId} {
      allow read, write: if request.auth != null && (request.auth.token.role == 'staff' || request.auth.token.isAdmin == true);
    }
  }
}
